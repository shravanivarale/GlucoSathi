# Copy this file to `.env` and fill in real values. Never commit `.env` —
# it is gitignored and holds real secrets.

# Required for the food-recognition endpoints (/api/v1/foods/recognize and
# /api/v1/foods/analyze). The rest of the API runs without it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the recognition model (default: gemini-3.6-flash).
# GEMINI_MODEL=gemini-3.6-flash