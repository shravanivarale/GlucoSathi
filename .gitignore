app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment files — never commit real secrets. .env is the live config;
# .env.* covers variants like .env.local / .env.dev. The template is committed.
.env
.env.*

!.env.example

# Generated nutrition database (seeded from the INDB dataset by backend/app/seed)
backend/data/*.db

